{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/api/config",
      "destination": "/api/config.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
